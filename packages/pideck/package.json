{
  "name": "pideck",
  "version": "0.1.0",
  "description": "Start and connect the PiDeck companion from Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "bin": "./bin/pideck.cjs",
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.cjs && node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
