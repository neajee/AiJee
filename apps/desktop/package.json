{
  "name": "@aijee/desktop",
  "version": "0.1.0",
  "description": "AiJee desktop shell",
  "author": "AiJee contributors",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "check": "node --check src/main.cjs"
  },
  "dependencies": {
    "aijee": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.anthaathi.aijee",
    "productName": "AiJee",
    "executableName": "aijee",
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  }
}
