{
  "name": "@aijee/desktop",
  "version": "0.1.0",
  "description": "AiJee desktop shell",
  "author": "AiJee contributors",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "yarn build:runtime && electron-builder",
    "build:runtime": "node tools/build-runtime.mjs",
    "check": "node --check src/main.cjs"
  },
  "dependencies": {
    "aijee": "workspace:*"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.anthaathi.aijee",
    "productName": "AiJee",
    "executableName": "aijee",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "files": [
      "src/**/*",
      "dist-runtime/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  }
}
