{
  "name": "aijee",
  "version": "0.1.1",
  "description": "AiJee embedded Pi SDK runtime and companion plugin",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "bin": "bin/aijee.cjs",
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "files": [
    "src",
    "bin",
    "public",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aijee/engine": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "undici": "^8.9.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
