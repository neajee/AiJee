{
  "expo": {
    "name": "AiJee",
    "slug": "aijee",
    "version": "0.1.1",
    "icon": "../../packages/ui/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static",
      "favicon": "../../packages/ui/assets/images/favicon.png",
      "name": "AiJee"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../../packages/ui/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
